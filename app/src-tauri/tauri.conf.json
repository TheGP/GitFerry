{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitFerry",
  "version": "0.1.1",
  "identifier": "com.gitferry.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GitFerry",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": {
      "resources/gitferry-agent-linux-x64": "gitferry-agent-linux-x64",
      "resources/gitferry-agent-linux-arm64": "gitferry-agent-linux-arm64"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
